{
  "name": "Sales Picker",
  "author": {
    "name": "SSK",
    "email": "example@example.com"
  },
  "defaultLocale": "ja",
  "private": true,
  "location": {
    "support": {
      "ticket_sidebar": {
        "url": "assets/iframe.html",
        "flexible": true
      },
      "new_ticket_sidebar": {
        "url": "assets/iframe.html",
        "flexible": true
      }
    }
  },
  "domainWhitelist": [
    "script.google.com",
    "script.googleusercontent.com"
  ],
  "parameters": [
    {
      "name": "gasUrl",
      "type": "text",
      "required": true
    },
    {
      "name": "sharedSecret",
      "type": "text",
      "secure": true,
      "required": true,
      "scopes": ["body"]
    },
    {
      "name": "devSharedSecret",
      "type": "text",
      "required": false
    }
  ],
  "version": "1.0.1",
  "frameworkVersion": "2.0"
}
